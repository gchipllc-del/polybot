# ============================================================
# POLYBOT — API Keys & Secrets
# Copy to .env and fill in your keys
# NEVER commit .env to git (it's in .gitignore by default)
# ============================================================
#
# QUICK START FOR THE KALSHI DAILY-BTC LIVE BOT:
#   REQUIRED:    KALSHI_API_KEY + KALSHI_PRIVATE_KEY_PATH (below)
#   RECOMMENDED: TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID (bottom of file)
#   IGNORE:      Everything else — only needed by other strategies.
#
# Run ./setup.sh for an interactive walkthrough that sets these.
# ============================================================

# --- Kalshi (REQUIRED for live trading) ---
# Sign up + fund at https://kalshi.com, then:
#   Settings → API Keys → Create new API key
#   Kalshi gives you:
#     • An API key UUID         → paste as KALSHI_API_KEY below
#     • A downloadable .pem file → save to ~/.polybot/kalshi_key.pem
KALSHI_API_KEY=your_kalshi_api_key
KALSHI_PRIVATE_KEY_PATH=~/.polybot/kalshi_key.pem

# --- Dashboard kill-switch reset (token-gated, money-affecting control) ---
# The web dashboard binds to 0.0.0.0 (reachable from your phone on the same
# WiFi) and is otherwise unauthenticated. The "Reset kill switch" button
# re-arms real-money trading, so its endpoint REQUIRES this shared secret.
# If unset, the reset endpoint is hard-disabled (button returns 503) — the bot
# still trades normally; you just can't reset the kill switch from the web UI
# (use `python main.py kalshi-live-reset` on the Mac instead).
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(24))"
KILL_SWITCH_RESET_TOKEN=

# --- Polymarket (Polygon L2) ---
POLY_PRIVATE_KEY=your_polygon_wallet_private_key
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Manifold (Paper Trading) ---
MANIFOLD_API_KEY=your_manifold_api_key

# --- LLM Superforecaster Ensemble ---
# Providers are configured in config/strategy.yaml under forecasting.llm_providers.
# Any provider with a missing key is silently skipped at runtime, so setting
# only some of these still works -- you just get a smaller ensemble.
#
# ── Free-tier providers (active default ensemble) ─────────────────────
GOOGLE_API_KEY=your_google_ai_studio_key      # Gemini 2.5 Pro — https://aistudio.google.com/app/apikey
GROQ_API_KEY=your_groq_key                    # DeepSeek-R1-distill-70b — https://console.groq.com/keys
CEREBRAS_API_KEY=your_cerebras_key            # Llama 3.3 70B — https://cloud.cerebras.ai/

# ── Local inference (optional) ────────────────────────────────────────
# Set to literally "ollama" (or any non-empty string) after running
# `ollama serve` + `ollama pull deepseek-r1:32b`. Then uncomment the
# ollama block in config/strategy.yaml.
# OLLAMA_API_KEY=ollama

# ── Paid providers (legacy; require funded accounts) ──────────────────
# These three were the original ensemble. They're disabled by default in
# strategy.yaml. Re-enable AND fund the account before the bot can use them.
ANTHROPIC_API_KEY=your_anthropic_api_key      # Claude Sonnet 4.6 — best calibrated
DEEPSEEK_API_KEY=your_deepseek_api_key        # DeepSeek-V3 / R1 — cheapest, strong CoT
MOONSHOT_API_KEY=your_moonshot_api_key        # Kimi K2 — news-heavy markets, tiebreaker

# --- News Sources ---
NEWS_API_KEY=your_newsapi_key

# --- Metaculus (community forecasts, optional but strong signal) ---
# Get token at https://www.metaculus.com/accounts/profile/ → API tokens
METACULUS_API_TOKEN=your_metaculus_api_token

# --- Market Data Providers (institutional-grade, optional) ---
# Databento — ticker-level historical + live (equities, futures, options, crypto)
# Free tier: $125/month credit. Get key at https://databento.com/portal/keys
DATABENTO_API_KEY=your_databento_api_key
# Twelve Data — broader coverage (stocks/forex/crypto/etfs), generous free tier
# Free tier: 8 RPM, 800 calls/day. Get key at https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# --- Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
